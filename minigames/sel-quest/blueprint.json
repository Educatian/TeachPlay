  ],
  "taskTemplate": {
    "characteristic": [
      "peer-conflict vignette with a distressed NPC",
      "2-3 tiered decision nodes per quest",
      "2-3 option choices, length-balanced to prevent test-wiseness",
      "poor choice triggers reflective feedback and an unscored retry",
      "NPC verbalizes the strategy chain at quest close"
